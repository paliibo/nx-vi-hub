# syntax=docker/dockerfile:1

# --- build ------------------------------------------------------------------
FROM node:22-alpine AS builder

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY package/db/prisma ./package/db/prisma

RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

COPY . .

# Baked into the client bundle at build time, so it has to be an address the
# user's browser can reach — not an internal compose hostname.
ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:4308
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL

RUN pnpm nx build web

# --- runtime ----------------------------------------------------------------
FROM node:22-alpine AS runner

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

WORKDIR /app

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 vihub

# `output: "standalone"` emits a self-contained server with only the modules it
# actually imports, so the runtime image needs no install step at all.
COPY --from=builder --chown=vihub:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=vihub:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=vihub:nodejs /app/apps/web/public ./apps/web/public

USER vihub

EXPOSE 3000

CMD ["node", "apps/web/server.js"]
