# ---------------------------------------------------------------------------
# Vi Hub — local configuration
#
#   cp .env.example .env
#
# Every workspace project reads this single file: Prisma resolves it from the
# repository root, the API loads it on boot, and next.config.js forwards the
# public values into the browser bundle.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Matches the `postgres` service in docker-compose.yaml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vihub?schema=public"

# --- API -------------------------------------------------------------------
PORT=4308
NODE_ENV=development

# Origin allowed to send credentialed requests to the API.
WEB_ORIGIN="http://localhost:3000"

# Generate your own with: openssl rand -base64 48
ACCESS_TOKEN_SECRET="dev-only-access-secret-change-me"
REFRESH_TOKEN_SECRET="dev-only-refresh-secret-change-me"

# Lifetimes accepted by `jsonwebtoken` (e.g. 15m, 12h, 30d).
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

# --- Web -------------------------------------------------------------------
# Used by React Server Components running inside the Next.js process.
API_BASE_URL="http://localhost:4308"
# Used by the browser bundle. Must be reachable from the user's machine.
NEXT_PUBLIC_API_BASE_URL="http://localhost:4308"
