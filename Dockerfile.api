# syntax=docker/dockerfile:1

# --- build ------------------------------------------------------------------
FROM node:22-alpine AS builder

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

WORKDIR /app

# Copy the manifests first so a source-only change reuses the install layer.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY package/db/prisma ./package/db/prisma

RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

COPY . .

RUN pnpm nx build api

# Compiled to plain JavaScript so the runtime image needs no ts-node.
RUN pnpm nx run db:build-seed

# --- runtime ----------------------------------------------------------------
FROM node:22-alpine AS runner

ENV NODE_ENV=production
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

WORKDIR /app

# Running as a non-root user limits what a compromised process can reach.
RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 vihub

COPY --from=builder /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml /app/.npmrc ./
COPY --from=builder /app/package/db/prisma ./package/db/prisma

# Production dependencies only. The Prisma engine still needs generating, which
# the postinstall hook handles.
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
  pnpm install --frozen-lockfile --prod --ignore-scripts \
  && pnpm exec prisma generate --schema=package/db/prisma/schema.prisma

COPY --from=builder /app/dist/apps/api ./dist/apps/api
COPY --from=builder /app/dist/seed ./dist/seed

USER vihub

EXPOSE 4308

# Compose can only tell that the port is open; this confirms the process is
# actually serving.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:4308/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "dist/apps/api/main.js"]
