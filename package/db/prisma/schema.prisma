generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

model User {
  id String @id @default(uuid())

  email        String @unique
  username     String @unique
  displayName  String
  passwordHash String

  avatarUrl String?
  bio       String?
  role      Role    @default(USER)

  channel       Channel?
  refreshTokens RefreshToken[]
  reactions     Reaction[]
  comments      Comment[]
  subscriptions Subscription[]
  playlists     Playlist[]
  watchHistory  WatchHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One row per issued refresh token. Tokens are stored hashed so a database
/// leak cannot be replayed against the API. Rotation revokes the previous row.
model RefreshToken {
  id String @id @default(uuid())

  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Channel {
  id String @id @default(uuid())

  handle      String  @unique
  name        String
  description String?
  avatarUrl   String?
  bannerUrl   String?
  accentColor String  @default("#a3e635")

  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  videos        Video[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id String @id @default(uuid())

  slug        String @unique
  name        String
  description String?
  accentColor String @default("#a3e635")
  position    Int    @default(0)

  videos Video[]
}

model Tag {
  id String @id @default(uuid())

  slug String @unique
  name String

  videos VideoTag[]
}

enum Visibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

model Video {
  id String @id @default(uuid())

  slug        String @unique
  title       String
  description String @default("")

  /// Poster frame. Seeded content uses locally generated SVG data, so the app
  /// renders identically with no network access.
  thumbnailUrl    String?
  sourceUrl       String?
  durationSeconds Int     @default(0)

  views      Int        @default(0)
  visibility Visibility @default(PUBLIC)

  publishedAt DateTime @default(now())

  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  tags          VideoTag[]
  reactions     Reaction[]
  comments      Comment[]
  playlistItems PlaylistItem[]
  watchHistory  WatchHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([channelId])
  @@index([categoryId])
  @@index([publishedAt])
  @@index([views])
  @@index([visibility, publishedAt])
}

model VideoTag {
  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  tagId String
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([videoId, tagId])
  @@index([tagId])
}

// ---------------------------------------------------------------------------
// Engagement
// ---------------------------------------------------------------------------

enum ReactionType {
  LIKE
  DISLIKE
}

model Reaction {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  type ReactionType

  createdAt DateTime @default(now())

  @@id([userId, videoId])
  @@index([videoId, type])
}

model Comment {
  id String @id @default(uuid())

  body String

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  /// Self-relation giving one level of threaded replies.
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([videoId, createdAt])
  @@index([parentId])
  @@index([authorId])
}

model Subscription {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, channelId])
  @@index([channelId])
}

// ---------------------------------------------------------------------------
// Library
// ---------------------------------------------------------------------------

/// `system` marks the two playlists created with every account (Watch later,
/// Liked videos) so the UI can render them differently and block deletion.
model Playlist {
  id String @id @default(uuid())

  title       String
  description String?
  visibility  Visibility @default(PRIVATE)
  system      String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  items PlaylistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, system])
  @@index([ownerId])
}

model PlaylistItem {
  id String @id @default(uuid())

  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  position Int

  addedAt DateTime @default(now())

  @@unique([playlistId, videoId])
  @@index([playlistId, position])
}

model WatchHistory {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  /// Resume point, in seconds, powering the "Continue watching" shelf.
  positionSeconds Int      @default(0)
  completed       Boolean  @default(false)
  watchedAt       DateTime @default(now())

  @@id([userId, videoId])
  @@index([userId, watchedAt])
}
