{
  "name": "db",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "package/db/src",
  "projectType": "library",
  "targets": {
    "prisma": {
      "command": "prisma",
      "options": {
        "cwd": "package/db"
      }
    },
    "push": {
      "command": "prisma db push",
      "options": {
        "cwd": "package/db"
      }
    },
    "pull": {
      "command": "prisma db pull",
      "options": {
        "cwd": "package/db"
      }
    },
    "seed": {
      "command": "prisma db seed",
      "options": {
        "cwd": "package/db"
      }
    },
    "generate": {
      "command": "prisma generate",
      "options": {
        "cwd": "package/db"
      }
    },
    "migrate:dev": {
      "command": "prisma migrate dev",
      "options": {
        "cwd": "package/db"
      }
    },
    "migrate:deploy": {
      "command": "prisma migrate deploy",
      "options": {
        "cwd": "package/db"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["package/db/**/*.ts", "package/db/package.json"]
      }
    }
  },
  "tags": []
}
