{
  "name": "db",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "package/db/src",
  "projectType": "library",
  "// note": "Targets run from the workspace root so Prisma picks up the single root .env.",
  "targets": {
    "generate": {
      "command": "prisma generate --schema=package/db/prisma/schema.prisma"
    },
    "push": {
      "command": "prisma db push --schema=package/db/prisma/schema.prisma"
    },
    "studio": {
      "command": "prisma studio --schema=package/db/prisma/schema.prisma"
    },
    "format": {
      "command": "prisma format --schema=package/db/prisma/schema.prisma"
    },
    "validate": {
      "command": "prisma validate --schema=package/db/prisma/schema.prisma"
    },
    "seed": {
      "command": "ts-node -P package/db/tsconfig.seed.json package/db/src/seed/index.ts"
    },
    "reset": {
      "command": "prisma migrate reset --force --schema=package/db/prisma/schema.prisma"
    },
    "migrate:dev": {
      "command": "prisma migrate dev --schema=package/db/prisma/schema.prisma"
    },
    "migrate:deploy": {
      "command": "prisma migrate deploy --schema=package/db/prisma/schema.prisma"
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "package/db/**/*.ts"
        ]
      }
    }
  },
  "tags": [
    "scope:db",
    "type:data"
  ]
}
